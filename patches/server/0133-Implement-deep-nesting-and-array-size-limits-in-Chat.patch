From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: codenicollas <work.nicollas@gmail.com>
Date: Fri, 20 Feb 2026 19:38:56 -0300
Subject: [PATCH] Implement deep-nesting and array size limits in
 ChatSerializer


diff --git a/src/main/java/net/minecraft/server/IChatBaseComponent.java b/src/main/java/net/minecraft/server/IChatBaseComponent.java
index 9854326f726e10751370d6f06b849f496a0f5da1..9ca603f9de479e957abecaaa256dcca7c0f0b8dc 100644
--- a/src/main/java/net/minecraft/server/IChatBaseComponent.java
+++ b/src/main/java/net/minecraft/server/IChatBaseComponent.java
@@ -35,11 +35,16 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
 
     public static class ChatSerializer implements JsonDeserializer<IChatBaseComponent>, JsonSerializer<IChatBaseComponent> {
 
+        private static final int MAX_COMPONENT_DEPTH = 128;
+        private static final int MAX_COMPONENT_ARRAY_SIZE = 128;
+
         private static final Gson a;
 
         public ChatSerializer() {}
 
         public IChatBaseComponent a(JsonElement jsonelement, Type type, JsonDeserializationContext jsondeserializationcontext) throws JsonParseException {
+            this.validateJsonTree(jsonelement, 0);
+            
             if (jsonelement.isJsonPrimitive()) {
                 return new ChatComponentText(jsonelement.getAsString());
             } else if (!jsonelement.isJsonObject()) {
@@ -124,6 +129,32 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
                 return (IChatBaseComponent) object;
             }
         }
+        
+        // PandaSpigot start
+        private void validateJsonTree(JsonElement element, int currentDepth) throws JsonParseException {
+            if (currentDepth > MAX_COMPONENT_DEPTH) {
+                throw new JsonParseException("ChatComponent is too complex (depth > " + MAX_COMPONENT_DEPTH + ")");
+            }
+            
+            if (element.isJsonArray()) {
+                JsonArray array = element.getAsJsonArray();
+
+                if (array.size() > MAX_COMPONENT_ARRAY_SIZE) {
+                    throw new JsonParseException("ChatComponent array is too large (size > " + MAX_COMPONENT_ARRAY_SIZE + ")");
+                }
+
+                for (JsonElement child : array) {
+                    this.validateJsonTree(child, currentDepth + 1);
+                }
+            } else if (element.isJsonObject()) {
+                JsonObject object = element.getAsJsonObject();
+
+                for (Entry<String, JsonElement> entry : object.entrySet()) {
+                    this.validateJsonTree(entry.getValue(), currentDepth + 1);
+                }
+            }
+        }
+        // PandaSpigot end
 
         private void a(ChatModifier chatmodifier, JsonObject jsonobject, JsonSerializationContext jsonserializationcontext) {
             JsonElement jsonelement = jsonserializationcontext.serialize(chatmodifier);
