 public class ChunkCache implements IBlockAccess {
 
+    private static final IBlockData DEFAULT_BLOCK = Blocks.AIR.getBlockData(); // PandaSpigot - Lithium:
+                                                                               // ai/pathing/ChunkCache
+
     protected int a;
     protected int b;
     protected Chunk[][] c;
     protected boolean d;
     protected World e;
 
+    // PandaSpigot start - Lithium: Optimize AI ChunkCache
+    // A 1D view of the chunks available to this cache
+    private Chunk[] chunksFlat;
+
