From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: codenicollas <work.nicollas@gmail.com>
Date: Wed, 25 Feb 2026 17:45:02 -0300
Subject: [PATCH] Implement deep-nesting and array size limits in
 ChatSerializer


diff --git a/src/main/java/net/minecraft/server/IChatBaseComponent.java b/src/main/java/net/minecraft/server/IChatBaseComponent.java
index 9854326f726e10751370d6f06b849f496a0f5da1..fb7f853d4aa5a372c9782137ade5454e5ef3bd01 100644
--- a/src/main/java/net/minecraft/server/IChatBaseComponent.java
+++ b/src/main/java/net/minecraft/server/IChatBaseComponent.java
@@ -35,16 +35,44 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
 
     public static class ChatSerializer implements JsonDeserializer<IChatBaseComponent>, JsonSerializer<IChatBaseComponent> {
 
+        // PandaSpigot start - Chat limits
+        private static final int MAX_COMPONENT_DEPTH = 128;
+        private static final int MAX_COMPONENT_ARRAY_SIZE = 256;
+        private static final ThreadLocal<Integer> depthTracker = new ThreadLocal<Integer>() {
+
+            @Override
+            protected Integer initialValue() {
+                return 0;
+            }
+        };
+        // PandaSpigot end
+
         private static final Gson a;
 
         public ChatSerializer() {}
 
         public IChatBaseComponent a(JsonElement jsonelement, Type type, JsonDeserializationContext jsondeserializationcontext) throws JsonParseException {
+            // PandaSpigot start - Validate depth
+            int currentDepth = depthTracker.get() + 1;
+            if (currentDepth > MAX_COMPONENT_DEPTH) {
+                throw new JsonParseException("ChatComponent is too complex (depth > " + MAX_COMPONENT_DEPTH + ")");
+            }
+            depthTracker.set(currentDepth);
+            // PandaSpigot end
+            
+            try { // PandaSpigot - Try block to ensure depth is decremented
             if (jsonelement.isJsonPrimitive()) {
                 return new ChatComponentText(jsonelement.getAsString());
             } else if (!jsonelement.isJsonObject()) {
                 if (jsonelement.isJsonArray()) {
                     JsonArray jsonarray = jsonelement.getAsJsonArray();
+
+                    // PandaSpigot start - Array limit
+                    if (jsonarray.size() > MAX_COMPONENT_ARRAY_SIZE) {
+                        throw new JsonParseException("ChatComponent array is too large (size > " + MAX_COMPONENT_ARRAY_SIZE + ")");
+                    }
+                    // PandaSpigot end
+
                     IChatBaseComponent ichatbasecomponent = null;
 
                     for (JsonElement jsonelement1 : jsonarray) {
@@ -72,6 +100,13 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
 
                     if (jsonobject.has("with")) {
                         JsonArray jsonarray1 = jsonobject.getAsJsonArray("with");
+
+                        // PandaSpigot start - Array limit
+                        if (jsonarray1.size() > MAX_COMPONENT_ARRAY_SIZE) {
+                            throw new JsonParseException("ChatComponent array is too large (size > " + MAX_COMPONENT_ARRAY_SIZE + ")");
+                        }
+                        // PandaSpigot end
+
                         Object[] aobject = new Object[jsonarray1.size()];
 
                         for (int i = 0; i < aobject.length; ++i) {
@@ -111,6 +146,12 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
                 if (jsonobject.has("extra")) {
                     JsonArray jsonarray2 = jsonobject.getAsJsonArray("extra");
 
+                    // PandaSpigot start - Array limit
+                    if (jsonarray2.size() > MAX_COMPONENT_ARRAY_SIZE) {
+                        throw new JsonParseException("ChatComponent array is too large (size > " + MAX_COMPONENT_ARRAY_SIZE + ")");
+                    }
+                    // PandaSpigot end
+
                     if (jsonarray2.size() <= 0) {
                         throw new JsonParseException("Unexpected empty array of components");
                     }
@@ -123,7 +164,12 @@ public interface IChatBaseComponent extends Iterable<IChatBaseComponent> {
                 ((IChatBaseComponent) object).setChatModifier((ChatModifier) jsondeserializationcontext.deserialize(jsonelement, ChatModifier.class));
                 return (IChatBaseComponent) object;
             }
+        } finally {
+            // PandaSpigot start - Decrease depth safely
+            depthTracker.set(depthTracker.get() - 1);
+            // PandaSpigot end
         }
+    }
 
         private void a(ChatModifier chatmodifier, JsonObject jsonobject, JsonSerializationContext jsonserializationcontext) {
             JsonElement jsonelement = jsonserializationcontext.serialize(chatmodifier);
