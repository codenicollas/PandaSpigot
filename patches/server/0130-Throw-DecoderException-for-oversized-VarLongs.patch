From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: codenicollas <work.nicollas@gmail.com>
Date: Sun, 22 Feb 2026 12:55:31 -0300
Subject: [PATCH] Throw DecoderException for oversized VarLongs


diff --git a/src/main/java/net/minecraft/server/PacketDataSerializer.java b/src/main/java/net/minecraft/server/PacketDataSerializer.java
index 053d0d816e84847c04337311a2a995cfe1328e42..52c53d0bd0e3c2b44dbb924c886aef8d2e78af16 100644
--- a/src/main/java/net/minecraft/server/PacketDataSerializer.java
+++ b/src/main/java/net/minecraft/server/PacketDataSerializer.java
@@ -103,7 +103,7 @@ public class PacketDataSerializer extends ByteBuf {
             b0 = this.readByte();
             i |= (long) (b0 & 127) << j++ * 7;
             if (j > 10) {
-                throw new RuntimeException("VarLong too big");
+                throw new io.netty.handler.codec.DecoderException("VarLong too big");
             }
         } while ((b0 & 128) == 128);
 
